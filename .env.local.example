# ── Copy to .env.local for local dev. On Vercel, set these in
#    Project → Settings → Environment Variables instead. ──

# Base URL the browser uses for API calls. Keep as "/api" so calls stay
# same-origin and are proxied to the backend by next.config.mjs rewrites
# (this keeps the auth cookie first-party — important in production).
NEXT_PUBLIC_API_URL=/api

# Server-only: where next.config proxies /api/* to. NOT exposed to the browser.
# Local:      http://localhost:5000   (or 5055)
# Production: your deployed backend URL, e.g. https://little-bird-backend.vercel.app
BACKEND_URL=http://localhost:5000

# Disable analytics in dev/preview; set to "true" (or remove) in production.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ── Cloudinary (public cloud name only) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Firebase web config (PUBLIC keys — safe in the browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
